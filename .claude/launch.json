{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ora-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8081"
      ],
      "cwd": "frontend",
      "port": 8081,
      "env": {
        "ORA_SKIP_CMD_GUARD": "1"
      }
    },
    {
      "name": "ora-api",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "server:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8001"
      ],
      "cwd": "backend",
      "port": 8001
    }
  ]
}
