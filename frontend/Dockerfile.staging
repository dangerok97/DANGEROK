# Build the complete pinned BodyParts3D 4.0 reference viewer (source is MIT; meshes CC BY 4.0).
FROM node:22-bookworm-slim AS bodyparts3d-builder
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY scripts /usr/local/share/ora-vision-scripts
RUN sh /usr/local/share/ora-vision-scripts/build-bodyparts3d.sh /vendor/bodyparts3d

FROM node:20-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
COPY scripts ./scripts
RUN npm ci

COPY . .

ARG EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID
ENV EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=${EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID}
ARG EXPO_PUBLIC_MAPS_WEB_KEY
ENV EXPO_PUBLIC_MAPS_WEB_KEY=${EXPO_PUBLIC_MAPS_WEB_KEY}
ARG EXPO_PUBLIC_IOS_ROOMPLAN_READY=0
ENV EXPO_PUBLIC_IOS_ROOMPLAN_READY=${EXPO_PUBLIC_IOS_ROOMPLAN_READY}
ARG EXPO_PUBLIC_IOS_INSTALL_URL
ENV EXPO_PUBLIC_IOS_INSTALL_URL=${EXPO_PUBLIC_IOS_INSTALL_URL}
ENV NODE_ENV=production
ENV EXPO_PUBLIC_BACKEND_URL=https://ora-backend-production-aa56.up.railway.app

RUN npx expo export --platform web --output-dir dist && sh scripts/inject-pwa.sh dist

FROM nginx:1.27-alpine

RUN sed -i 's#^error_log .*;#error_log /dev/stdout warn;#' /etc/nginx/nginx.conf
COPY nginx.staging.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html
COPY --from=bodyparts3d-builder /vendor/bodyparts3d/dist /usr/share/nginx/html/bodyparts3d

EXPOSE 8080
