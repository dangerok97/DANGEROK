import React,{useEffect,useRef,useState} from 'react';
import * as T from 'three';
import {OrbitControls} from 'three/examples/jsm/controls/OrbitControls.js';
import {createOraParticleBrain} from './ora-brain-field';
import './ora-brain.css';

type Star={id:string;area:string;kind:'node'|'branch';tentative?:boolean;temporary?:boolean;complete?:boolean};
type State={mode?:'idle'|'listen'|'think'|'speak';paused?:boolean;reduced?:boolean;active?:boolean;
 selectedIndex?:number|null;resetKey?:number;zoomOverride?:number;spotlightId?:string|null;
 area?:string|null;stars?:Star[]};
type Datum={index:number;area:string;kind:'area'|'node'|'branch';id?:string;
 temporary?:boolean;tentative?:boolean;complete?:boolean};
type Marker={datum:Datum;core:T.Mesh;halo:T.Sprite;label?:HTMLButtonElement;leader?:SVGLineElement};
const AREAS=[
 {id:'memory',label:'MEMORIA',x:.22,y:.34,z:.40},
 {id:'calendar',label:'IMPEGNI',x:-.51,y:.31,z:.33},
 {id:'people',label:'PERSONE',x:.62,y:-.26,z:.35},
 {id:'places',label:'LUOGHI',x:-.52,y:-.26,z:.32},
 {id:'home',label:'CASA',x:-.05,y:-.12,z:.40},
 {id:'documents',label:'DOCUMENTI',x:.50,y:.18,z:.36},
 {id:'finances',label:'FINANZE',x:-.78,y:.05,z:.22},
 {id:'calls',label:'CHIAMATE',x:.30,y:-.13,z:.40},
] as const;
const clamp=(v:number,a:number,b:number)=>Math.max(a,Math.min(b,v));
const hash=(value:string)=>{let n=2166136261;
 for(let i=0;i<value.length;i++)n=Math.imul(n^value.charCodeAt(i),16777619)>>>0;
 return n>>>0;};
function synapseTexture(){
 const canvas=document.createElement('canvas');canvas.width=canvas.height=128;
 const ctx=canvas.getContext('2d');if(!ctx)throw Error('synapse_canvas_unavailable');
 const g=ctx.createRadialGradient(64,64,0,64,64,64);
 g.addColorStop(0,'rgba(255,255,255,1)');
 g.addColorStop(.10,'rgba(255,254,239,.98)');
 g.addColorStop(.28,'rgba(255,235,185,.40)');
 g.addColorStop(.60,'rgba(255,190,93,.10)');
 g.addColorStop(1,'rgba(255,190,93,0)');
 ctx.fillStyle=g;ctx.fillRect(0,0,128,128);
 return new T.CanvasTexture(canvas);
}

export default function OraBrain(){
 const host=useRef<HTMLDivElement>(null);
 const [status,setStatus]=useState<'loading'|'ready'|'error'>('loading');
 const [error,setError]=useState('');
 useEffect(()=>{
  const el=host.current;if(!el)return;
  let disposed=false,frame=0;
  const current:{value:State}={value:{mode:'idle',stars:[],paused:false,reduced:false,zoomOverride:1,resetKey:0}};
  const send=(payload:unknown)=>{
   if(window.parent!==window)window.parent.postMessage(payload,window.location.origin);
  };
  let renderer:T.WebGLRenderer;
  try{
   renderer=new T.WebGLRenderer({antialias:true,alpha:true,powerPreference:'high-performance'});
  }catch{
   setStatus('error');setError('WebGL non disponibile su questo dispositivo');
   send({type:'ora:brain-error',version:1});
   return;
  }
  renderer.setClearColor(0x000000,0);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio||1,1.65));
  renderer.outputColorSpace=T.SRGBColorSpace;
  renderer.domElement.setAttribute('aria-label','Cervello olografico di ORA: trascina per ruotare, tocca una sinapsi per aprirla.');
  el.appendChild(renderer.domElement);
  const scene=new T.Scene(),camera=new T.PerspectiveCamera(35,1,.01,100);
  const controls=new OrbitControls(camera,renderer.domElement);
  controls.enableDamping=true;controls.dampingFactor=.075;
  controls.enablePan=false;controls.autoRotate=false;
  const brain=new T.Group();scene.add(brain);
  const hologram=createOraParticleBrain(scene,brain);
  hologram.setPixelRatio(Math.min(window.devicePixelRatio||1,1.65));
  const texture=synapseTexture();
  const coreGeometry=new T.SphereGeometry(1,14,10);
  const markers:Marker[]=[];
  let neuralLinks:T.LineSegments|null=null;
  const hubMaterial=new T.SpriteMaterial({map:texture,color:0xb6edff,transparent:true,opacity:.72,depthWrite:false,depthTest:false,blending:T.AdditiveBlending});
  const hub=new T.Sprite(hubMaterial);hub.position.set(-.03,-.10,.46);hub.scale.set(.16,.16,1);brain.add(hub);
  const labelLayer=document.createElement('div');
  labelLayer.className='ora-brain-label-layer';el.appendChild(labelLayer);
  const lines=document.createElementNS('http://www.w3.org/2000/svg','svg');
  lines.setAttribute('class','ora-brain-leaders');
  lines.setAttribute('aria-hidden','true');
  labelLayer.appendChild(lines);
  const nodeColor=(m:Datum)=>{
   if(m.temporary)return 0xff6177;
   if(m.tentative)return 0xffc071;
   return m.kind==='area'?0x82dcff:0xffedbb;
  };
  const trigger=(m:Datum)=>send({type:'ora:brain-select',version:1,node:m});
  const removeMarkers=()=>{
   if(neuralLinks){brain.remove(neuralLinks);neuralLinks.geometry.dispose();(neuralLinks.material as T.Material).dispose();neuralLinks=null;}
   for(const m of markers){
    m.core.removeFromParent();m.halo.removeFromParent();
    (m.core.material as T.Material).dispose();(m.halo.material as T.Material).dispose();
    m.label?.remove();m.leader?.remove();
   }
   markers.length=0;
  };
  const centerFor=(m:Datum)=>{
   const area=AREAS.find(a=>a.id===m.area)||AREAS[0];
   const h=hash(m.id||m.area),jitter=m.kind==='area'?0:.31;
   return hologram.preferredPosition(new T.Vector3(
    area.x+jitter*((h&255)/255-.5),
    area.y+jitter*(((h>>>8)&255)/255-.5),
    area.z
   ));
  };
  const rebuild=()=>{
   removeMarkers();
   const stars=current.value.stars||[];
   const defs:Datum[]=[
    ...AREAS.map((a,i)=>({index:i,area:a.id,kind:'area' as const})),
    ...stars.map((s,i)=>({index:i+8,area:s.area,kind:s.kind,id:s.id,
      temporary:!!s.temporary,tentative:!!s.tentative,complete:!!s.complete}))
   ];
   defs.forEach(m=>{
    const golden=m.kind!=='area';
    const mat=new T.MeshBasicMaterial({color:nodeColor(m),transparent:true,opacity:golden?1:.74,depthWrite:false});
    const core=new T.Mesh(coreGeometry,mat);
    core.position.copy(centerFor(m));core.scale.setScalar(golden?.037:.022);
    core.userData.oraNode=m;
    const haloMat=new T.SpriteMaterial({
     map:texture,color:m.temporary?0xff8491:m.tentative?0xffca8e:golden?0xffe1b5:0x68d7ff,
     transparent:true,opacity:golden?.98:.32,depthWrite:false,depthTest:false,
     blending:T.AdditiveBlending
    });
    const halo=new T.Sprite(haloMat);
    halo.position.copy(core.position);
    halo.scale.set(golden?.30:.09,golden?.30:.09,1);
    brain.add(core,halo);
    const entry:Marker={datum:m,core,halo};
    // Editorial labels are positioned OUTSIDE the hologram; all other areas
    // remain accessible through ORA's existing area list and selectable dots.
    if(m.kind==='area'&&['calendar','memory','places','people'].includes(m.area)){
     const a=AREAS.find(a=>a.id===m.area)||AREAS[0];
     const btn=document.createElement('button');
     btn.type='button';btn.className='ora-brain-label ora-brain-label-'+m.area;
     btn.textContent=a.label;btn.setAttribute('aria-label','Apri '+a.label.toLowerCase());
     btn.addEventListener('click',e=>{e.stopPropagation();trigger(m);});
     labelLayer.appendChild(btn);entry.label=btn;
     const leader=document.createElementNS('http://www.w3.org/2000/svg','line');
     leader.setAttribute('stroke','#91d9ff');leader.setAttribute('stroke-width','1');
     leader.setAttribute('opacity','.64');lines.appendChild(leader);entry.leader=leader;
    }
    markers.push(entry);
   });
   // Three-dimensional connection fibres carry energy between the central
   // blue hub and the actual owned knowledge/area points, never decorative hits.
   const links:number[]=[];
   const start=new T.Vector3(-.03,-.10,.46);
   markers.forEach(m=>{
    const end=m.core.position,control=start.clone().lerp(end,.52).add(new T.Vector3(0,.15,.11));
    let previous=start;
    for(let step=1;step<=30;step++){
     const t=step/30,u=1-t;
     const next=new T.Vector3(u*u*start.x+2*u*t*control.x+t*t*end.x,
       u*u*start.y+2*u*t*control.y+t*t*end.y,
       u*u*start.z+2*u*t*control.z+t*t*end.z);
     links.push(previous.x,previous.y,previous.z,next.x,next.y,next.z);
     previous=next;
    }
   });
   const geometry=new T.BufferGeometry();
   geometry.setAttribute('position',new T.Float32BufferAttribute(links,3));
   const material=new T.LineBasicMaterial({color:0x6ac5ff,transparent:true,opacity:.22,depthWrite:false,blending:T.AdditiveBlending});
   neuralLinks=new T.LineSegments(geometry,material);neuralLinks.frustumCulled=false;brain.add(neuralLinks);
  };
  let lastReset=0,lastZoom=1,lastSig='';
  const fit=()=>{
   const w=Math.max(1,el.clientWidth),h=Math.max(1,el.clientHeight);
   const needed=2.45/(2*Math.tan(T.MathUtils.degToRad(camera.fov/2))*Math.max(.30,w/h)*.89);
   const distance=Math.max(4.6,needed);
   controls.target.set(0,-.17,0);
   camera.position.set(.13,.09,distance);
   controls.minDistance=distance*.50;controls.maxDistance=distance*2.3;
   camera.near=.01;camera.far=Math.max(50,distance*12);
   camera.updateProjectionMatrix();controls.update();
  };
  const applyZoom=()=>{
   const z=clamp(Number(current.value.zoomOverride)||1,.72,1.55);
   if(z!==lastZoom){lastZoom=z;camera.zoom=z;camera.updateProjectionMatrix();}
  };
  const updateLabels=()=>{
   const w=Math.max(1,el.clientWidth),h=Math.max(1,el.clientHeight);
   lines.setAttribute('viewBox','0 0 '+w+' '+h);
   const position=new T.Vector3(),projected=new T.Vector3();
   for(const m of markers){
    if(!m.label||!m.leader)continue;
    const left=m.datum.area==='calendar'||m.datum.area==='places';
    const upper=m.datum.area==='calendar'||m.datum.area==='memory';
    const bx=w*(left?.17:.83),by=h*(upper?.24:.74);
    m.label.style.left=bx+'px';m.label.style.top=by+'px';
    m.core.getWorldPosition(position);projected.copy(position).project(camera);
    const x=(projected.x*.5+.5)*w,y=(-projected.y*.5+.5)*h;
    m.leader.setAttribute('x1',String(bx+(left?45:-45)));
    m.leader.setAttribute('y1',String(by+5));
    m.leader.setAttribute('x2',String(x));
    m.leader.setAttribute('y2',String(y));
    m.leader.setAttribute('opacity',projected.z>-1&&projected.z<1?'.62':'0');
    m.label.classList.toggle('active',current.value.area===m.datum.area||
      current.value.selectedIndex===m.datum.index);
   }
  };
  const observer=new ResizeObserver(()=>{
   if(disposed)return;
   const w=Math.max(1,el.clientWidth),h=Math.max(1,el.clientHeight);
   const dpr=Math.min(window.devicePixelRatio||1,w<700?1.50:1.80);
   renderer.setPixelRatio(dpr);hologram.setPixelRatio(dpr);
   renderer.setSize(w,h,false);camera.aspect=w/h;camera.updateProjectionMatrix();
   fit();applyZoom();updateLabels();
  });
  observer.observe(el);
  const onMessage=(event:MessageEvent)=>{
   if(event.source!==window.parent||event.origin!==window.location.origin)return;
   const p=event.data;if(!p||p.type!=='ora:brain-state'||typeof p.options!=='object')return;
   const next=p.options as State,stars=Array.isArray(next.stars)?next.stars:current.value.stars||[];
   const sig=JSON.stringify(stars.map(s=>[s.id,s.area,s.kind,!!s.temporary,!!s.tentative,!!s.complete]));
   const changed=sig!==lastSig;current.value={...current.value,...next,stars};
   if(changed){lastSig=sig;rebuild();}
   if((next.resetKey??0)!==lastReset){lastReset=next.resetKey??0;fit();}
   applyZoom();
  };
  window.addEventListener('message',onMessage);
  const down:{current:{x:number;y:number;id:number}|null}={current:null};
  const pointerDown=(e:PointerEvent)=>{down.current={x:e.clientX,y:e.clientY,id:e.pointerId};};
  const pointerUp=(e:PointerEvent)=>{
   if(!down.current||down.current.id!==e.pointerId)return;
   const moved=Math.hypot(e.clientX-down.current.x,e.clientY-down.current.y)>12;
   down.current=null;if(moved)return;
   const rect=renderer.domElement.getBoundingClientRect();
   const x=(e.clientX-rect.left)/rect.width*2-1;
   const y=-(e.clientY-rect.top)/rect.height*2+1;
   const ray=new T.Raycaster();ray.setFromCamera(new T.Vector2(x,y),camera);
   const intersect=ray.intersectObjects(markers.map(m=>m.core),false)[0];
   if(intersect){
    const node=intersect.object.userData.oraNode as Datum|undefined;
    if(node)trigger(node);
   }
  };
  renderer.domElement.addEventListener('pointerdown',pointerDown);
  renderer.domElement.addEventListener('pointerup',pointerUp);
  const clock=new T.Clock();
  const animate=()=>{
   if(disposed)return;frame=requestAnimationFrame(animate);
   const seconds=clock.getElapsedTime(),state=current.value;
   const busy=state.mode==='think'||state.mode==='listen'||state.mode==='speak';
   hologram.animate(seconds,busy,!!state.paused||!!state.reduced);
   controls.update();
   for(const m of markers){
    const active=state.selectedIndex===m.datum.index||
     (!!m.datum.id&&m.datum.id===state.spotlightId);
    const golden=m.datum.kind!=='area';
    const r=golden?(active?.43:.30):(active?.20:.09);
    m.halo.scale.set(r,r,1);
    (m.halo.material as T.SpriteMaterial).opacity=active?1:golden?.80+.16*Math.sin(seconds*2+m.datum.index):.32;
    m.core.scale.setScalar((golden?.037:.022)*(active?1.5:1));
   }
   updateLabels();renderer.render(scene,camera);
  };
  rebuild();fit();
  setStatus('ready');
  send({type:'ora:brain-ready',version:1,
   visualProfile:hologram.visualProfile,particleCount:hologram.particleCount});
  animate();
  const onContextLost=(e:Event)=>{
   e.preventDefault();setStatus('error');
   setError('Sessione WebGL interrotta');send({type:'ora:brain-error',version:1});
  };
  renderer.domElement.addEventListener('webglcontextlost',onContextLost);
  return()=>{
   disposed=true;cancelAnimationFrame(frame);observer.disconnect();
   window.removeEventListener('message',onMessage);
   renderer.domElement.removeEventListener('pointerdown',pointerDown);
   renderer.domElement.removeEventListener('pointerup',pointerUp);
   renderer.domElement.removeEventListener('webglcontextlost',onContextLost);
   controls.dispose();removeMarkers();coreGeometry.dispose();hubMaterial.dispose();texture.dispose();
   hologram.dispose();labelLayer.remove();renderer.dispose();renderer.domElement.remove();
  };
 },[]);
 return <main className="ora-brain-presence" data-testid="ora-brain-webgl"
  data-visual-profile="particle-hologram-v184" data-status={status}>
  <div className="ora-brain-aura" aria-hidden="true"/>
  <div className="ora-brain-host" ref={host}/>
  {status==='error'?<div className="ora-brain-status error" role="alert">{error}</div>:null}
 </main>;
}
