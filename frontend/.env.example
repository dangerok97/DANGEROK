# ORA frontend — copy to frontend/.env
# Expo only exposes vars prefixed with EXPO_PUBLIC_

# Backend API origin (no trailing /api — client adds /api)
# Prefer 127.0.0.1 for web/emulator. For a physical phone use LAN IP, e.g.:
# EXPO_PUBLIC_BACKEND_URL=http://192.168.0.123:8000
EXPO_PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# Set to 1 to use fake Apple calendars/events in dev (web/unsupported devices)
EXPO_PUBLIC_APPLE_CALENDAR_MOCK=0

# Optional hint recorded by setup scripts
# EXPO_PUBLIC_LAN_IP=192.168.0.123

# --- Google Sign-In (public client IDs only — never secrets) ---
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# --- Apple Sign-In (public) ---
# Services ID for web / Android browser OAuth (no private key here)
EXPO_PUBLIC_APPLE_SERVICE_ID=
# Optional redirect for web Apple flow (must match Apple Developer return URL)
# EXPO_PUBLIC_APPLE_REDIRECT_URI=http://127.0.0.1:8081/login
