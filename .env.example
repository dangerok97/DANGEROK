# Copia in .env (NON committare .env). Genera le chiavi con:
#   python -m app.cli genera-chiavi
DATABASE_URL=sqlite:///./dangerok.db      # in produzione: postgresql+psycopg://...
DATA_KEY=
SESSION_SECRET=
HTTPS_ONLY=1                              # 0 solo per sviluppo locale
ANTHROPIC_API_KEY=                        # se vuoto l'AI resta disattivata
ANTHROPIC_MODEL=claude-opus-5-5
