FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=1
WORKDIR /worker
COPY cutout_worker_requirements.txt .
RUN python -m pip install --no-cache-dir -r cutout_worker_requirements.txt
COPY cutout_worker_download.py .
RUN python cutout_worker_download.py
COPY cutout_worker.py .
EXPOSE 8080
CMD ["uvicorn","cutout_worker:app","--host","0.0.0.0","--port","8080","--workers","1","--no-access-log"]
