# ORA backend — copy to backend/.env and fill values.
# Never commit real secrets.

# --- Required for boot ---
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=ora_local
JWT_SECRET=change-me-to-a-long-random-string

# --- Intent Classification Engine (deterministic; LLM optional) ---
# Set 1 to allow Gemini/etc. to enrich ambiguous intents only.
# Flow routing works fully with INTENT_LLM_ENRICH=0 (default).
INTENT_LLM_ENRICH=0

# --- LLM Provider Manager (optional — app boots without AI) ---
# Preferred provider: gemini | openai | ollama | emergent | auto
# Default priority / failover: gemini → openai → ollama → emergent
LLM_PROVIDER=gemini

# Google Gemini (default for local/dev — free tier)
GEMINI_API_KEY=
# Prefer flash-lite for free-tier headroom; 2.0-flash may hit quota sooner
GEMINI_MODEL=gemini-flash-lite-latest
# Optional alternate model before Provider Manager failover
# GEMINI_FALLBACK_MODEL=gemini-2.0-flash
# GEMINI_TIMEOUT_S=60

# OpenAI (kept; used on failover or if preferred)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama local (auto-probed unless OLLAMA_ENABLED=0)
OLLAMA_ENABLED=auto
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Emergent (optional)
EMERGENT_LLM_KEY=
# LLM_MODEL=

# --- Emergent Google login bridge (legacy, off by default) ---
EMERGENT_GOOGLE_AUTH=0

# --- Google Sign-In (first-party ID token audiences) ---
# Create OAuth clients in Google Cloud Console (separate Web / iOS / Android).
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
# Optional extra audiences (comma-separated)
# GOOGLE_ALLOWED_CLIENT_IDS=
# Client secret only if you use auth-code exchange server-side (not required for ID-token verify)
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://127.0.0.1:8081
#
# Google Cloud Console (Sign-In Web client) MUST list BOTH hosts — they are
# different origins to Google:
#   Authorized JavaScript origins:
#     http://localhost:8081
#     http://127.0.0.1:8081
#   Authorized redirect URIs:
#     http://localhost:8081
#     http://127.0.0.1:8081

# --- Sign in with Apple ---
# APPLE_CLIENT_ID / APPLE_BUNDLE_ID = iOS App ID (audience for native tokens)
# APPLE_SERVICE_ID = Services ID (web / Android browser flow audience)
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_CLIENT_ID=
APPLE_BUNDLE_ID=com.emergent.oradecisionengine.b7escs
APPLE_SERVICE_ID=
APPLE_REDIRECT_URI=https://your-domain.example/auth/apple/callback
# Prefer path to .p8 (never commit the key file)
APPLE_PRIVATE_KEY_PATH=
# Or PEM contents (dev only; still never commit real keys)
# APPLE_PRIVATE_KEY=

# --- Optional environment ---
ENVIRONMENT=development
ORA_DEFAULT_TZ=Europe/Rome

# --- Google Calendar OAuth (connector) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Primary callback (Google Console must match exactly). In local/dev ORA also
# accepts the localhost ↔ 127.0.0.1 twin automatically — register BOTH in Console:
#   http://localhost:8000/api/connectors/google-calendar/oauth/callback
#   http://127.0.0.1:8000/api/connectors/google-calendar/oauth/callback
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/connectors/google-calendar/oauth/callback
# Optional extra callbacks (comma-separated), in addition to auto loopback twin:
# GOOGLE_OAUTH_REDIRECT_URIS=
# Post-OAuth browser return allowlist (comma-separated origins). Defaults include
# http://localhost:8081 and http://127.0.0.1:8081 in development.
# FRONTEND_URLS=http://localhost:8081,http://127.0.0.1:8081
GOOGLE_CALENDAR_INITIAL_WINDOW_PAST_DAYS=7
GOOGLE_CALENDAR_INITIAL_WINDOW_FUTURE_DAYS=30
GOOGLE_CALENDAR_MAX_WINDOW_DAYS=90
GOOGLE_CALENDAR_POLL_INTERVAL_MIN=15

# --- Apple Calendar connector flags ---
APPLE_CALENDAR_ENABLED=1
APPLE_CALENDAR_WINDOW_PAST_DAYS=7
APPLE_CALENDAR_WINDOW_FUTURE_DAYS=30

# --- Feature flags (defaults mirror production-ish Emergent setup; adjust locally) ---
CONTEXT_ASSEMBLER_ENABLED=1
CALENDAR_CONTEXT_ENABLED=1
CALENDAR_DECISION_GENERATION_ENABLED=1
CALENDAR_PROVIDER_MODE=real
DAILY_SUMMARY_ENABLED=1
EXPLAINABILITY_ENABLED=1
ACTION_CENTER_ENABLED=1
BEHAVIOR_PROFILE_ENABLED=1
BEHAVIOR_SHADOW_MODE=0
PERMISSIONS_CONTEXT_ENABLED=1
DOCUMENT_CONTEXT_ENABLED=1
DOCUMENT_EXTRACTION_ENABLED=1
# Goal Engine Foundation — shadow Goals on Study/Travel confirm (default ON locally).
# When OFF (0), GoalService.upsert is a no-op. No Goal UX / Home ranking changes yet.
GOAL_ENGINE_ENABLED=1
# Proactive Engine — IF/WHEN/HOW/WHY ORA should intervene (default ON locally).
# When OFF (0), no suggestions generated; Home "ORA TI CONSIGLIA" stays empty.
# Email/Finance/Weather/Health/WhatsApp are predisposed stubs only — never invent facts.
PROACTIVE_ENGINE_ENABLED=1

# --- Conversation Engine (entry orchestrator — NOT a chatbot) ---
# Default ON locally. OFF → /api/conversation/* returns disabled; Home PARLA falls back.
CONVERSATION_ENGINE_ENABLED=1

# --- Semantic Extraction + Gap Analyzer (default ON) ---
# Deterministic Italian extraction always works without Gemini.
# Optional Gemini fill via Provider Manager when GEMINI_API_KEY is set.
SEMANTIC_ENGINE_ENABLED=1
SEMANTIC_GEMINI_ENABLED=1
SEMANTIC_GEMINI_REPHRASE=0
SEMANTIC_CACHE_TTL_SEC=600
SEMANTIC_CONFIDENCE_HIGH=0.85
SEMANTIC_CONFIDENCE_MEDIUM=0.60

# --- Life Setup + AI Life Strategist (first-launch conversation, NOT a wizard) ---
# Default ON locally. After complete/skip/interrupt the module is invisible forever.
# Soft resume only via ONE Proactive/Home suggestion — never "Completa il profilo".
LIFE_SETUP_ENABLED=1
AI_LIFE_STRATEGIST_ENABLED=1
# Structured Gemini plans via Provider Manager; deterministic fallback if absent.
AI_LIFE_STRATEGIST_GEMINI=1
AI_LIFE_STRATEGIST_CACHE_TTL_SEC=600
AI_LIFE_STRATEGIST_CACHE_MAX=256
# Email / Open Banking / WhatsApp / Weather — adapter stubs only (not operational).

# --- Life Object Engine (core identity — SHADOW mode) ---
# Default ON: parallel writes to life_objects after Documents/Goals/Travel/Study.
# Does NOT replace Goal-aware Home. Documents V2 remains sole upload/OCR pipeline.
LIFE_OBJECT_ENGINE_ENABLED=1
# Home V3 Life Objects view — default OFF (no major UX change yet). PREDISPOSTO only.
LIFE_OBJECT_HOME_UI_ENABLED=0
# Structured Gemini object reasoning + enrichment (narrative/questions/insights/temporal/health)
# via Provider Manager; deterministic Italian fallback if absent / LIFE_OBJECT_GEMINI=0.
LIFE_OBJECT_GEMINI=1

# Enable after installing Tesseract on the host
DOCUMENT_OCR_ENABLED=1
# Windows example after `winget install UB-Mannheim.TesseractOCR`:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
# Intelligent document AI enrichment (uses LLM adapter when configured)
DOCUMENT_AI_ENABLED=1
# User prefs (Mongo preferences.*): calendar_auto_add_enabled default false;
# calendar_auto_add_threshold default 0.90 — set via PATCH /api/documents/preferences

# Cost controls for document AI (chars / chunks / timeout / retries)
DOCUMENT_AI_MAX_CHARS=12000
DOCUMENT_AI_MAX_CHUNKS=3
DOCUMENT_AI_TIMEOUT_S=60
DOCUMENT_AI_MAX_RETRIES=2

# --- Documents storage ---
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_STORAGE_DIR=./data/documents
DOCUMENT_MAX_SIZE_BYTES=10485760
# DOCUMENT_ALLOWED_MIMES=application/pdf,image/png,image/jpeg
# DOCUMENT_OCR_LANGS=ita+eng
# DOCUMENT_INSIGHTS_CONFIDENCE_THRESHOLD=0.6
# DOCUMENT_INSIGHTS_HIDDEN_LOWER_THRESHOLD=0.35

# --- Token vault for connector secrets (Google Calendar OAuth tokens) ---
# Backend `local` is an alias of Fernet. Never commit real keys.
TOKEN_VAULT_BACKEND=local
# Prefer: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Passphrases are also accepted (SHA-256 → Fernet key) for local/dev only.
TOKEN_VAULT_KEY=change-me-token-vault-key-32bytes-min
# Alias accepted by the vault factory (same role as TOKEN_VAULT_KEY):
# OAUTH_TOKEN_ENCRYPTION_KEY=
#
# Google Calendar write scopes (requested on Collega Google Calendar, NOT login):
#   https://www.googleapis.com/auth/calendar.events
#   https://www.googleapis.com/auth/calendar.calendarlist.readonly
# Redirect URI(s) must match Google Cloud Console (see GOOGLE_OAUTH_REDIRECT_URI).
# Prefer one canonical API host in the browser, but register both loopback forms.

# --- Misc / permissions ---
PERMISSION_AUDIT_RETENTION_DAYS=90

# Used by some smoke tests when pointing at this API
# Prefer 127.0.0.1 or localhost consistently with frontend/.env — both work if
# Google Console lists both Calendar callback URIs above.
EXPO_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
# EXPO_BACKEND_URL=http://127.0.0.1:8000
