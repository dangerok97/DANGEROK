# ORA backend — copy to backend/.env and fill values.
# Never commit real secrets.

# --- Required for boot ---
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=ora_local
JWT_SECRET=change-me-to-a-long-random-string

# --- LLM Provider Manager (optional — app boots without AI) ---
# Preferred provider: gemini | openai | ollama | emergent | auto
# Default priority / failover: gemini → openai → ollama → emergent
LLM_PROVIDER=gemini

# Google Gemini (default for local/dev — free tier)
GEMINI_API_KEY=
# Prefer flash-lite for free-tier headroom; 2.0-flash may hit quota sooner
GEMINI_MODEL=gemini-flash-lite-latest
# Optional alternate model before Provider Manager failover
# GEMINI_FALLBACK_MODEL=gemini-2.0-flash
# GEMINI_TIMEOUT_S=60

# OpenAI (kept; used on failover or if preferred)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama local (auto-probed unless OLLAMA_ENABLED=0)
OLLAMA_ENABLED=auto
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Emergent (optional)
EMERGENT_LLM_KEY=
# LLM_MODEL=

# --- Emergent Google login bridge (legacy, off by default) ---
EMERGENT_GOOGLE_AUTH=0

# --- Google Sign-In (first-party ID token audiences) ---
# Create OAuth clients in Google Cloud Console (separate Web / iOS / Android).
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
# Optional extra audiences (comma-separated)
# GOOGLE_ALLOWED_CLIENT_IDS=
# Client secret only if you use auth-code exchange server-side (not required for ID-token verify)
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://127.0.0.1:8081

# --- Sign in with Apple ---
# APPLE_CLIENT_ID / APPLE_BUNDLE_ID = iOS App ID (audience for native tokens)
# APPLE_SERVICE_ID = Services ID (web / Android browser flow audience)
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_CLIENT_ID=
APPLE_BUNDLE_ID=com.emergent.oradecisionengine.b7escs
APPLE_SERVICE_ID=
APPLE_REDIRECT_URI=https://your-domain.example/auth/apple/callback
# Prefer path to .p8 (never commit the key file)
APPLE_PRIVATE_KEY_PATH=
# Or PEM contents (dev only; still never commit real keys)
# APPLE_PRIVATE_KEY=

# --- Optional environment ---
ENVIRONMENT=development
ORA_DEFAULT_TZ=Europe/Rome

# --- Google Calendar OAuth (connector) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/connectors/google-calendar/oauth/callback
GOOGLE_CALENDAR_INITIAL_WINDOW_PAST_DAYS=7
GOOGLE_CALENDAR_INITIAL_WINDOW_FUTURE_DAYS=30
GOOGLE_CALENDAR_MAX_WINDOW_DAYS=90
GOOGLE_CALENDAR_POLL_INTERVAL_MIN=15

# --- Apple Calendar connector flags ---
APPLE_CALENDAR_ENABLED=1
APPLE_CALENDAR_WINDOW_PAST_DAYS=7
APPLE_CALENDAR_WINDOW_FUTURE_DAYS=30

# --- Feature flags (defaults mirror production-ish Emergent setup; adjust locally) ---
CONTEXT_ASSEMBLER_ENABLED=1
CALENDAR_CONTEXT_ENABLED=1
CALENDAR_DECISION_GENERATION_ENABLED=1
CALENDAR_PROVIDER_MODE=real
DAILY_SUMMARY_ENABLED=1
EXPLAINABILITY_ENABLED=1
ACTION_CENTER_ENABLED=1
BEHAVIOR_PROFILE_ENABLED=1
BEHAVIOR_SHADOW_MODE=0
PERMISSIONS_CONTEXT_ENABLED=1
DOCUMENT_CONTEXT_ENABLED=1
DOCUMENT_EXTRACTION_ENABLED=1
# Enable after installing Tesseract on the host
DOCUMENT_OCR_ENABLED=1
# Windows example after `winget install UB-Mannheim.TesseractOCR`:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
# Intelligent document AI enrichment (uses LLM adapter when configured)
DOCUMENT_AI_ENABLED=1
# Cost controls for document AI (chars / chunks / timeout / retries)
DOCUMENT_AI_MAX_CHARS=12000
DOCUMENT_AI_MAX_CHUNKS=3
DOCUMENT_AI_TIMEOUT_S=60
DOCUMENT_AI_MAX_RETRIES=2

# --- Documents storage ---
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_STORAGE_DIR=./data/documents
DOCUMENT_MAX_SIZE_BYTES=10485760
# DOCUMENT_ALLOWED_MIMES=application/pdf,image/png,image/jpeg
# DOCUMENT_OCR_LANGS=ita+eng
# DOCUMENT_INSIGHTS_CONFIDENCE_THRESHOLD=0.6
# DOCUMENT_INSIGHTS_HIDDEN_LOWER_THRESHOLD=0.35

# --- Token vault for connector secrets (Google Calendar OAuth tokens) ---
# Backend `local` is an alias of Fernet. Never commit real keys.
TOKEN_VAULT_BACKEND=local
# Prefer: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Passphrases are also accepted (SHA-256 → Fernet key) for local/dev only.
TOKEN_VAULT_KEY=change-me-token-vault-key-32bytes-min
# Alias accepted by the vault factory (same role as TOKEN_VAULT_KEY):
# OAUTH_TOKEN_ENCRYPTION_KEY=
#
# Google Calendar write scopes (requested on Collega Google Calendar, NOT login):
#   https://www.googleapis.com/auth/calendar.events
#   https://www.googleapis.com/auth/calendar.calendarlist.readonly
# Redirect URI must match Google Cloud Console exactly (see GOOGLE_OAUTH_REDIRECT_URI).

# --- Misc / permissions ---
PERMISSION_AUDIT_RETENTION_DAYS=90

# Used by some smoke tests when pointing at this API
EXPO_PUBLIC_BACKEND_URL=http://localhost:8000
# EXPO_BACKEND_URL=http://localhost:8000
